          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array and contains the food\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.be.an('array');\r\n\r\n    var foodName = pm.collectionVariables.get(\"randomFood\");\r\n    var found = jsonData.some(food => food.name === foodName);\r\n    pm.expect(found).to.be.true;\r\n});"
            ]
          }
        }
      ],
